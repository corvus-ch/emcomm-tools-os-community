+++ emcomm-tools-os-community/source/scripts/download-et-maps.sh
@@ -25,10 +25,8 @@ FILES=(
 
 if [ -z ${ET_MAP_SELECTION+x} ]; then
   # Show dialog
-  SELECTED_COUNTRY=$(dialog --clear --menu "Select a country" 10 40 5 "${OPTIONS[@]}" 2>&1 >/dev/tty)
+  SELECTED_COUNTRY=$(dialog --erase-on-exit --stdout --menu "Select a country" 10 40 5 "${OPTIONS[@]}")
   EXIT_STATUS=$?
-
-  tput sgr0 && clear
 else
   SELECTED_COUNTRY=$ET_MAP_SELECTION
   EXIT_STATUS=0
